{
  "name": "pinned-repos-for-github",
  "description": "Pin your favorite repositories to the top of your GitHub home dashboard.",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "lint:firefox": "wxt build -b firefox && web-ext lint -s .output/firefox-mv2",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.mjs",
    "dev:firefox": "wxt -b firefox"
  },
  "dependencies": {
    "github-url-detection": "^11.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
